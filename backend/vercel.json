{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.ts": {
      "maxDuration": 10
    },
    "api/rooms/*.ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/index" },
    { "source": "/latest.json", "destination": "/api/updater" }
  ]
}
