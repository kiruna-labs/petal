# Petal backend env — server-side ONLY. NEVER commit real values; NEVER expose
# LIVEKIT_API_SECRET to any client. On Vercel these are Project Environment
# Variables; locally, copy to .env (gitignored) for `test:local`.

# LiveKit Cloud project (or ws://localhost:7880 + devkey/secret for local test).
# These are the only env vars the core token/rooms service needs — no database.
# Rooms live entirely on LiveKit (discovery via listRooms + room metadata).
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Optional — AI chat (/api/ai-token, #655). Leaving GEMINI_API_KEY unset is
# the supported "no AI chat" configuration AND the global kill switch: every
# request then returns 503 "AI chat is not configured". The key is used only
# to mint short-lived ephemeral tokens; it is never returned to a client.
# GEMINI_API_KEY=
# GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview
