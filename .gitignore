# Node
node_modules/
npm-debug.log*

# Vite / SvelteKit build output
dist/
build/
.svelte-kit/

# Rust / Tauri
target/
src-tauri/target/
src-tauri/gen/

# Logs
*.log
# ...except the synthetic petal.log fixtures scripts/test-analyze-field-log.mjs
# reads. They keep the real extension because the analyzer's directory and
# gzip handling keys off it.
!scripts/fixtures/field-logs/*.log

# macOS
.DS_Store

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
# Per-machine cockpit baseline; the comparison script owns this file.
baseline.json

# Multi-agent scratch: counselor reports, session artifacts. Never committed —
# may cite third-party products/sources that must not enter lasting repo resources.
agents/

# Environment / provider state — never track, at any depth
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
.vercel/
**/.vercel/

# Machine-local agent/session state
.claude/
.codex/

# Local build output not covered by target/
target-peer/

# Vendored crates are path/git patches, so the app build resolves them inside
# apps/desktop/src-tauri/Cargo.lock -- the only lock that governs a release. A
# nested lock is resolved standalone (no pin from the app graph) and can encode
# a version this repo does not support; see docs/ENGINEERING.md.
apps/desktop/vendor/**/Cargo.lock

# Local, machine-specific PII deny-list for scan-for-pii.mjs (never commit).
site/.pii-patterns.local.json
.pii-patterns.local.json
.omp/
