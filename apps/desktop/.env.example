# Token backend endpoint. The desktop app asks this service for scoped LiveKit
# tokens and room presence; LiveKit API secrets must stay on the backend in
# shipped builds.
#
# There is NO default. A build that leaves this unset cannot mint tokens and
# every join fails -- deliberate, so a third-party build never silently uses
# the maintainers' hosted service. Set it to your own deployment
# (docs/SELF_HOSTING.md), or set it EMPTY in a debug build to use the local
# dev mint against a local LiveKit.
#
# Local app startup loads both apps/desktop/.env and apps/desktop/src-tauri/.env
# without overriding variables already set in the process environment.
PETAL_BACKEND_URL=https://your-backend.example.com

# Optional local dev/probe credentials. Debug app builds can use these as a
# local token fallback when PETAL_BACKEND_URL is unset; release builds still
# require the backend.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
